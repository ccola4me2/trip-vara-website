# Public site URL, used for canonical tags, sitemap.xml and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://tripvaratravel.com

# GoHighLevel (sub-account "Trip Vara").
# Location ID is already hardcoded in src/config/ghl.ts and does not need an env var.
#
# Form ID: in GHL go to Sites > Forms > (your quote form) > Integrate,
# copy the id from the embed URL .../widget/form/<FORM_ID>
NEXT_PUBLIC_GHL_FORM_ID=

# Calendar ID: in GHL go to Calendars > (your discovery call calendar) > Embed,
# copy the id from the embed URL .../widget/booking/<CALENDAR_ID>
NEXT_PUBLIC_GHL_CALENDAR_ID=
