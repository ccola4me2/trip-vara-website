{
  "name": "trip-vara-portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Trip Vara advisor portal: a travel-advisor CRM front end over GoHighLevel, on Cloudflare Workers + D1.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply trip-vara --remote",
    "db:migrate:local": "wrangler d1 migrations apply trip-vara --local",
    "check:columns": "node scripts/check-columns.mjs",
    "check:contracts": "node scripts/check-contracts.mjs",
    "check:smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "wrangler": "^3.90.0"
  }
}
